[
  {
    "id": "predict_chat_basic",
    "module": "predict",
    "adapter": "chat",
    "signature": "question -> answer",
    "instructions": "Answer the question.",
    "inputs": {
      "question": "What is the capital of France?"
    },
    "responses": [
      "[[ ## answer ## ]]\nParis"
    ],
    "expected_prediction": {
      "answer": "Paris"
    }
  },
  {
    "id": "chain_of_thought_basic",
    "module": "chain_of_thought",
    "adapter": "chat",
    "signature": "question -> answer",
    "instructions": "Solve the math problem.",
    "inputs": {
      "question": "What is 2 + 2?"
    },
    "responses": [
      "[[ ## reasoning ## ]]\n2 + 2 = 4\n[[ ## answer ## ]]\n4"
    ],
    "expected_prediction": {
      "reasoning": "2 + 2 = 4",
      "answer": "4"
    }
  },
