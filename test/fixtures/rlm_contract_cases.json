{
  "schema_version": 1,
  "purpose": "Provider-free operational semantics for current DSPy RLM; this is not long-context effectiveness evidence or a paper reproduction.",
  "cases": [
    {
      "id": "immediate_typed_submit",
      "invariant": "A correctly typed SUBMIT terminates on the first controller turn.",
      "disposition": "matched",
      "required": true,
      "inputs": {"context": "unused", "query": "return an integer"},
      "python_controller_code_turns": ["SUBMIT(answer=7)"],
      "elixir_controller_code_turns": ["submit(%{answer: 7})"],
      "subresponses": {},
      "budgets": {"max_iterations": 2, "max_llm_calls": 2},
      "expected": {"status": "submitted", "output": 7, "subcalls": 0, "trace_shape": {"entries": 1, "codes": ["SUBMIT(answer=7)"], "output_contains": ["FINAL:"]}}
    },
    {
      "id": "persistent_assignment",
      "invariant": "Python assignments survive across controller turns in the same interpreter.",
      "disposition": "matched",
      "required": true,
      "inputs": {"context": "alpha", "query": "persist state"},
      "python_controller_code_turns": ["saved = 40\nprint(saved)", "SUBMIT(answer=saved + 2)"],
      "elixir_controller_code_turns": ["saved = 40\nprint(saved)", "submit(%{answer: saved + 2})"],
      "subresponses": {},
      "budgets": {"max_iterations": 3, "max_llm_calls": 2},
      "expected": {"status": "submitted", "output": 42, "subcalls": 0, "trace_shape": {"entries": 2, "codes": ["saved = 40\nprint(saved)", "SUBMIT(answer=saved + 2)"], "output_contains": ["40", "FINAL:"]}}
    },
    {
      "id": "string_inspection",
      "invariant": "Controller code can inspect and transform string inputs.",
      "disposition": "matched",
      "required": true,
      "inputs": {"context": "  red,Green,BLUE  ", "query": "normalize"},
      "python_controller_code_turns": ["parts = [x.strip().lower() for x in context.strip().split(',')]\nprint(parts)", "SUBMIT(answer='|'.join(parts))"],
      "elixir_controller_code_turns": ["raw_parts = context |> String.trim() |> String.split(\",\")\nparts = for part <- raw_parts, do: part |> String.trim() |> String.downcase()\nprint(parts)", "submit(%{answer: Enum.join(parts, \"|\")})"],
      "subresponses": {},
      "budgets": {"max_iterations": 3, "max_llm_calls": 2},
      "expected": {"status": "submitted", "output": "red|green|blue", "subcalls": 0, "trace_shape": {"entries": 2, "output_contains": ["green", "FINAL:"]}}
    },
    {
      "id": "list_transformation",
      "invariant": "Structured list input remains usable by programmatic transformations.",
      "disposition": "matched",
      "required": true,
      "inputs": {"context": [1, 2, 3, 4], "query": "square evens"},
      "python_controller_code_turns": ["values = [n * n for n in context if n % 2 == 0]\nprint(values)", "SUBMIT(answer=values)"],
      "elixir_controller_code_turns": ["values = for n <- context, rem(n, 2) == 0, do: n * n\nprint(values)", "submit(%{answer: values})"],
      "subresponses": {},
      "budgets": {"max_iterations": 3, "max_llm_calls": 2},
      "output_type": "list[int]",
      "expected": {"status": "submitted", "output": [4, 16], "subcalls": 0, "trace_shape": {"entries": 2, "output_contains": ["[4, 16]", "FINAL:"]}}
    },
    {
      "id": "single_llm_query",
      "invariant": "llm_query invokes the deterministic sub-LM exactly once and returns its text.",
      "disposition": "matched",
      "required": true,
      "inputs": {"context": "unused", "query": "delegate"},
      "python_controller_code_turns": ["reply = llm_query('capital')\nprint(reply)", "SUBMIT(answer=reply)"],
      "elixir_controller_code_turns": ["reply = llm_query(\"capital\")\nprint(reply)", "submit(%{answer: reply})"],
      "subresponses": {"capital": "PARIS"},
      "budgets": {"max_iterations": 3, "max_llm_calls": 2},
      "expected": {"status": "submitted", "output": "PARIS", "subcalls": 1, "trace_shape": {"entries": 2, "output_contains": ["PARIS", "FINAL:"]}}
    },
    {
      "id": "llm_query_loop",
      "invariant": "llm_query remains callable from a programmatic loop with one call per element.",
      "disposition": "matched",
      "required": true,
      "inputs": {"context": ["a", "b", "c"], "query": "map"},
      "python_controller_code_turns": ["answers = [llm_query('item:' + x) for x in context]\nprint(answers)", "SUBMIT(answer=','.join(answers))"],
      "elixir_controller_code_turns": ["answers = for item <- context, do: llm_query(\"item:\" <> item)\nprint(answers)", "submit(%{answer: Enum.join(answers, \",\")})"],
      "subresponses": {"item:a": "A", "item:b": "B", "item:c": "C"},
      "budgets": {"max_iterations": 3, "max_llm_calls": 3},
      "expected": {"status": "submitted", "output": "A,B,C", "subcalls": 3, "trace_shape": {"entries": 2, "output_contains": ["A", "FINAL:"]}}
    },
    {
      "id": "batched_ordered_results",
      "invariant": "llm_query_batched returns results in prompt order even when callbacks complete concurrently.",
      "disposition": "matched",
      "required": true,
      "inputs": {"context": "unused", "query": "batch"},
      "python_controller_code_turns": ["batch = llm_query_batched(['slow', 'fast', 'middle'])\nprint(batch)", "SUBMIT(answer='>'.join(batch))"],
      "elixir_controller_code_turns": ["batch = llm_query_batched([\"slow\", \"fast\", \"middle\"])\nprint(batch)", "submit(%{answer: Enum.join(batch, \">\")})"],
      "subresponses": {"slow": "ONE", "fast": "TWO", "middle": "THREE"},
      "subresponse_delays_ms": {"slow": 30, "fast": 0, "middle": 10},
      "budgets": {"max_iterations": 3, "max_llm_calls": 3},
      "expected": {"status": "submitted", "output": "ONE>TWO>THREE", "subcalls": 3, "trace_shape": {"entries": 2, "output_contains": ["ONE", "TWO", "THREE", "FINAL:"]}}
    },
    {
      "id": "exact_batch_call_accounting",
      "invariant": "A batch consumes exactly one subcall budget unit per prompt, including duplicate prompts.",
      "disposition": "matched",
      "required": true,
      "inputs": {"context": "unused", "query": "count duplicates"},
      "python_controller_code_turns": ["batch = llm_query_batched(['x', 'x', 'y', 'x'])\nprint(len(batch))", "SUBMIT(answer=len(batch))"],
      "elixir_controller_code_turns": ["batch = llm_query_batched([\"x\", \"x\", \"y\", \"x\"])\nprint(Enum.count(batch))", "submit(%{answer: Enum.count(batch)})"],
      "subresponses": {"x": "X", "y": "Y"},
      "budgets": {"max_iterations": 3, "max_llm_calls": 4},
      "expected": {"status": "submitted", "output": 4, "subcalls": 4, "trace_shape": {"entries": 2, "output_contains": ["4", "FINAL:"]}}
    },
    {
      "id": "malformed_submit_repair",
      "invariant": "A malformed SUBMIT is retained as an error turn and a later valid SUBMIT can repair it.",
      "disposition": "matched",
      "required": true,
      "inputs": {"context": "unused", "query": "repair"},
      "python_controller_code_turns": ["SUBMIT(wrong='bad')", "SUBMIT(answer='repaired')"],
      "elixir_controller_code_turns": ["submit(%{wrong: \"bad\"})", "submit(%{answer: \"repaired\"})"],
      "subresponses": {},
      "budgets": {"max_iterations": 3, "max_llm_calls": 1},
      "expected": {"status": "submitted", "output": "repaired", "subcalls": 0, "trace_shape": {"entries": 2, "output_contains": ["Error", "FINAL:"]}}
    },
    {
      "id": "iteration_exhaustion_extract",
      "invariant": "Exhausting controller iterations invokes extract and retains the non-final trajectory.",
      "disposition": "matched",
      "required": true,
      "inputs": {"context": "seed", "query": "force extract"},
      "python_controller_code_turns": ["candidate = context.upper()\nprint(candidate)"],
      "elixir_controller_code_turns": ["candidate = String.upcase(context)\nprint(candidate)"],
      "extract_output": "EXTRACTED",
      "subresponses": {},
      "budgets": {"max_iterations": 1, "max_llm_calls": 1},
      "expected": {"status": "extracted", "output": "EXTRACTED", "subcalls": 0, "trace_shape": {"entries": 1, "output_contains": ["SEED"], "final_reasoning": "Extract forced final output"}}
    },
    {
      "id": "reject_over_budget_batch",
      "invariant": "An over-budget batch is rejected atomically before any sub-LM callback is invoked.",
      "disposition": "matched",
      "required": true,
      "inputs": {"context": "unused", "query": "budget"},
      "python_controller_code_turns": ["result = llm_query_batched(['a', 'b', 'c'])\nprint(result)", "SUBMIT(answer='rejected')"],
      "elixir_controller_code_turns": ["result = llm_query_batched([\"a\", \"b\", \"c\"])\nprint(result)", "submit(%{answer: \"rejected\"})"],
      "subresponses": {"a": "A", "b": "B", "c": "C"},
      "budgets": {"max_iterations": 3, "max_llm_calls": 2},
      "expected": {"status": "submitted", "output": "rejected", "subcalls": 0, "trace_shape": {"entries": 2, "output_contains": ["LLM call limit exceeded", "FINAL:"]}}
    },
    {
      "id": "state_output_trace_retention",
      "invariant": "Every attempted turn retains controller code and observable output while state feeds the final result.",
      "disposition": "matched",
      "required": true,
      "inputs": {"context": "trace", "query": "retain"},
      "python_controller_code_turns": ["memo = {'seen': context}\nprint('phase-one')", "memo['seen'] += '-kept'\nprint(memo['seen'])", "SUBMIT(answer=memo['seen'])"],
      "elixir_controller_code_turns": ["memo = %{seen: context}\nprint(\"phase-one\")", "memo = %{seen: memo[:seen] <> \"-kept\"}\nprint(memo[:seen])", "submit(%{answer: memo[:seen]})"],
      "subresponses": {},
      "budgets": {"max_iterations": 3, "max_llm_calls": 1},
      "expected": {"status": "submitted", "output": "trace-kept", "subcalls": 0, "trace_shape": {"entries": 3, "output_contains": ["phase-one", "trace-kept", "FINAL:"]}}
    },
    {
      "id": "dsex_symbolic_recurse_extension",
      "invariant": "DSEx exposes an explicit symbolic recurse/2 helper; current DSPy RLM exposes llm_query tools but no recurse helper.",
      "disposition": "deviation",
      "required": false,
      "deviation": "Declared DSEx extension: not executed as a Python matched case because injecting recurse would fabricate upstream DSPy behavior.",
      "inputs": {"context": "branch", "query": "symbolic recursion"},
      "python_controller_code_turns": ["# Unsupported upstream: recurse('branch', depth=2)"],
      "elixir_controller_code_turns": ["recurse(\"question -> answer\", %{question: \"branch\"})"],
      "subresponses": {},
      "budgets": {"max_iterations": 1, "max_llm_calls": 2},
      "expected": {"status": "supported_deviation", "output": null, "subcalls": 0, "trace_shape": {"entries": 0}}
    }
  ]
}
