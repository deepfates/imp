+"""Budget enforcement and redacted, atomic evidence artifacts."""
+
+from __future__ import annotations
+
+import contextlib
+import hashlib
+import json
+import os
+import subprocess
+import tempfile
+import threading
+from pathlib import Path
+from typing import Any, Iterator
+
+
+PHASES = ("optimization", "selection", "final_test")
+SECRET_KEY_MARKERS = ("api_key", "apikey", "authorization", "password", "secret", "token")
+PINNED_COMMITS = {
+    "gepa_artifact": "cbefbc1aa0f43dd39874ec4bf42211365dbda42e",
+    "dspy": "62dc3b634d7dc0c4889abcf905cb4c391ea6b396",
+    "arbor": "113fc35e05acbf2796a5917ec3b45ab44bfacd0b",
+}
+
+
+class MetricBudgetExceeded(RuntimeError):
+    """Raised before a metric callback would exceed its phase budget."""
+
+
+def _secret_values() -> set[str]:
+    return {
+        value
+        for key, value in os.environ.items()
+        if value and any(marker in key.lower() for marker in SECRET_KEY_MARKERS)
+    }
+
+
+def redact(value: Any) -> Any:
+    """Recursively redact credential-shaped fields before JSON serialization."""
+    if isinstance(value, dict):
+        return {
+            str(key): (
+                "[REDACTED]"
+                if any(marker in str(key).lower() for marker in SECRET_KEY_MARKERS)
+                else redact(item)
+            )
+            for key, item in value.items()
+        }
+    if isinstance(value, (list, tuple, set)):
+        return [redact(item) for item in value]
+    return value
+
+
+def atomic_json_dump(path: str | Path, payload: Any, *, default=None) -> None:
+    """Write redacted JSON using fsync plus atomic rename in the destination directory."""
+    destination = Path(path)
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    encoded = json.dumps(redact(payload), default=default, indent=2, sort_keys=True) + "\n"
+    for secret in sorted(_secret_values(), key=len, reverse=True):
+        encoded = encoded.replace(secret, "[REDACTED]")
+
+    fd, temporary = tempfile.mkstemp(prefix=f".{destination.name}.", dir=destination.parent)
+    try:
+        with os.fdopen(fd, "w", encoding="utf-8") as handle:
+            handle.write(encoded)
+            handle.flush()
+            os.fsync(handle.fileno())
+        os.replace(temporary, destination)
+    except BaseException:
+        with contextlib.suppress(FileNotFoundError):
+            os.unlink(temporary)
+        raise
+
+
+class PhaseMetricCounter:
+    """Thread-safe metric accounting with a hard optimization-phase backstop."""
+
+    def __init__(self, optimizer_limit: int | None = None, phase_limits: dict[str, int] | None = None):
+        if optimizer_limit is not None and optimizer_limit <= 0:
+            raise ValueError("optimizer_limit must be a positive integer")
+        self.optimizer_limit = optimizer_limit
+        self.phase_limits = dict(phase_limits or {})
+        if optimizer_limit is not None:
+            self.phase_limits["optimization"] = optimizer_limit
+        if any(phase not in PHASES or limit <= 0 for phase, limit in self.phase_limits.items()):
+            raise ValueError("phase limits must be positive integers for known phases")
+        self._phase = "selection"
+        self._phase_counts = {phase: 0 for phase in PHASES}
+        self._split_counts = {"train": 0, "val": 0, "test": 0, "unknown": 0}
+        self._denied = 0
+        self._lock = threading.Lock()
+
+    def set_phase(self, phase: str) -> None:
+        if phase not in PHASES:
+            raise ValueError(f"unknown metric phase: {phase}")
+        with self._lock:
+            self._phase = phase
+
+    @contextlib.contextmanager
+    def phase(self, phase: str) -> Iterator[None]:
+        with self._lock:
+            previous = self._phase
+        self.set_phase(phase)
+        try:
+            yield
+        finally:
+            self.set_phase(previous)
+
+    def reserve(self, example_split: str | None) -> tuple[int, int, int, int]:
+        """Reserve one callback before execution, rejecting call limit + 1."""
+        with self._lock:
+            phase_limit = self.phase_limits.get(self._phase)
+            if phase_limit is not None and self._phase_counts[self._phase] >= phase_limit:
+                self._denied += 1
+                raise MetricBudgetExceeded(
+                    f"{self._phase} metric budget exhausted at {phase_limit} calls"
+                )
+            self._phase_counts[self._phase] += 1
+            split = example_split if example_split in ("train", "val", "test") else "unknown"
+            self._split_counts[split] += 1
+            return (
+                sum(self._phase_counts.values()),
+                self._split_counts["train"],
+                self._split_counts["val"],
+                self._split_counts["test"],
+            )
+
+    def increment_and_return_state(self, example_split: str | None):
+        return self.reserve(example_split)
+
+    def snapshot(self) -> dict[str, Any]:
+        with self._lock:
+            return {
+                "phases": dict(self._phase_counts),
+                "splits": dict(self._split_counts),
+                "total": sum(self._phase_counts.values()),
+                "optimizer_limit": self.optimizer_limit,
+                "phase_limits": dict(self.phase_limits),
+                "denied_before_callback": self._denied,
+            }
+
+
+def _git_head(path: Path) -> str:
+    return subprocess.run(
+        ["git", "-C", str(path), "rev-parse", "HEAD"],
+        check=True,
+        capture_output=True,
+        text=True,
+    ).stdout.strip()
+
+
+def pinned_provenance(repo_root: str | Path) -> dict[str, Any]:
+    root = Path(repo_root).resolve()
+    paths = {
+        "gepa_artifact": root,
+        "dspy": root / "gepa_artifact/utils/dspy",
+        "arbor": root / "gepa_artifact/utils/arbor",
+    }
+    observed = {name: _git_head(path) for name, path in paths.items()}
+    if observed != PINNED_COMMITS:
+        raise RuntimeError(f"source checkout does not match pinned commits: {observed}")
+    provenance = {
+        "repositories": {
+            name: {
+                "commit": commit,
+                "working_tree_modified": bool(
+                    subprocess.run(
+                        ["git", "-C", str(paths[name]), "status", "--porcelain"],
+                        check=True,
+                        capture_output=True,
+                        text=True,
+                    ).stdout
+                ),
+            }
+            for name, commit in observed.items()
+        }
+    }
+    patch_path = root / "evidence/comparator-corrections.patch"
+    if patch_path.is_file():
+        provenance["source_patch"] = {
+            "path": "evidence/comparator-corrections.patch",
+            "sha256": sha256_file(patch_path),
+        }
+    return provenance
+
+
+def sha256_file(path: str | Path) -> str:
+    digest = hashlib.sha256()
+    with open(path, "rb") as handle:
+        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+class RunEvidenceRecorder:
+    """Write one non-aggregated, execution-derived comparator run manifest."""
+
+    def __init__(self, run_dir: str | Path, identity: dict[str, Any], counter: PhaseMetricCounter, provenance: dict[str, Any], *, synthetic: bool = False):
+        self.run_dir = Path(run_dir)
+        self.identity = identity
+        self.counter = counter
+        self.provenance = provenance
+        self.synthetic = synthetic
+        self.finalized = False
+        atomic_json_dump(self.run_dir / "provenance.json", provenance)
+
+    def finalize(self, status: str, *, score: float | None = None, result_path: str | Path | None = None, error_type: str | None = None) -> None:
+        snapshot = self.counter.snapshot()
+        evidence_phase = "final_test" if self.identity["optimizer"] == "Baseline" else "optimization"
+        limit = snapshot["phase_limits"].get(evidence_phase)
+        observed = snapshot["phases"][evidence_phase]
+        manifest = {
+            "schema_version": 1,
+            "kind": "gepa_upstream_run_manifest",
+            "synthetic": self.synthetic,
+            "status": status,
+            "identity": self.identity,
+            "source": self.provenance,
+            "metric_call_evidence": {
+                "basis": "observed_metric_callback_count",
+                "configured_limit": limit,
+                "observed": observed,
+                "evidence_phase": evidence_phase,
+                "phases": snapshot["phases"],
+                "splits": snapshot["splits"],
+                "enforced": limit is not None,
+                "denied_before_callback": snapshot["denied_before_callback"],
+                "within_budget": limit is None or observed <= limit,
+            },
+            "seed_selection": {
+                "method": "predeclared",
+                "seeds": [self.identity["seed"]],
+                "selected_seed": self.identity["seed"],
+                "selection_split": None,
+                "test_scores_used": False,
+            },
+            "evaluation": None,
+            "error_type": error_type,
+        }
+        if score is not None and result_path is not None:
+            manifest["evaluation"] = {
+                "split": "test",
+                "score": score,
+                "test_scores_used_for_selection": False,
+                "result_sha256": sha256_file(result_path),
+            }
+        atomic_json_dump(self.run_dir / "evidence_manifest.json", manifest)
+        self.finalized = True
