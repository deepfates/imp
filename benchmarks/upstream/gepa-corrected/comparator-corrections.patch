+#!/usr/bin/env python3
+"""Aggregate completed comparator run manifests for the DSEx evidence consumer."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+from gepa_artifact.utils.evidence import PINNED_COMMITS, atomic_json_dump, sha256_file
+
+
+FAMILY_PROGRAMS = {
+    "AIMEBench": "CoT",
+    "HotpotQABench": "HotpotMultiHop",
+    "hoverBench": "HoverMultiHop",
+    "IFBench": "IFBenchCoT2StageProgram",
+    "LiveBenchMathBench": "CoT",
+    "Papillon": "PAPILLON",
+}
+OPTIMIZERS = ("Baseline", "GEPA", "MIPROv2-Heavy")
+
+
+def load_run_manifest(path: Path) -> dict:
+    manifest = json.loads(path.read_text(encoding="utf-8"))
+    identity = manifest.get("identity", {})
+    metric = manifest.get("metric_call_evidence", {})
+    evaluation = manifest.get("evaluation") or {}
+    expected_phase = "final_test" if identity.get("optimizer") == "Baseline" else "optimization"
+    repositories = manifest.get("source", {}).get("repositories", {})
+    observed_pins = {name: value.get("commit") for name, value in repositories.items()}
+
+    valid = (
+        manifest.get("schema_version") == 1
+        and manifest.get("kind") == "gepa_upstream_run_manifest"
+        and manifest.get("synthetic") is False
+        and manifest.get("status") == "completed"
+        and identity.get("family") in FAMILY_PROGRAMS
+        and identity.get("program") == FAMILY_PROGRAMS.get(identity.get("family"))
+        and identity.get("optimizer") in OPTIMIZERS
+        and isinstance(identity.get("seed"), int)
+        and observed_pins == PINNED_COMMITS
+        and metric.get("basis") == "observed_metric_callback_count"
+        and metric.get("evidence_phase") == expected_phase
+        and isinstance(metric.get("observed"), int)
+        and metric.get("observed", 0) > 0
+        and isinstance(metric.get("configured_limit"), int)
+        and metric.get("observed") <= metric.get("configured_limit")
+        and metric.get("enforced") is True
+        and metric.get("within_budget") is True
+        and evaluation.get("split") == "test"
+        and evaluation.get("test_scores_used_for_selection") is False
+        and isinstance(evaluation.get("score"), (int, float))
+        and isinstance(evaluation.get("result_sha256"), str)
+        and len(evaluation.get("result_sha256")) == 64
+    )
+    if not valid:
+        raise ValueError(f"incomplete, synthetic, unpinned, or over-budget run manifest: {path}")
+    manifest["_path"] = str(path.resolve())
+    return manifest
+
+
+def build_sidecar(paths: list[Path], archive: Path) -> dict:
+    manifests = [load_run_manifest(path) for path in paths]
+    keyed = {
+        (item["identity"]["family"], item["identity"]["program"], item["identity"]["optimizer"]): item
+        for item in manifests
+    }
+    expected = {
+        (family, program, optimizer)
+        for family, program in FAMILY_PROGRAMS.items()
+        for optimizer in OPTIMIZERS
+    }
+    if len(keyed) != len(manifests) or set(keyed) != expected:
+        raise ValueError("run manifests must contain exactly one required family/program/optimizer tuple")
+    models = {item["identity"]["model"] for item in manifests}
+    if len(models) != 1:
+        raise ValueError("all run manifests must use one model")
+
+    runs = []
+    for manifest in manifests:
+        identity = manifest["identity"]
+        metric = manifest["metric_call_evidence"]
+        evaluation = manifest["evaluation"]
+        path = manifest["_path"]
+        runs.append({
+            **identity,
+            "metric_call_evidence": {
+                "basis": metric["basis"],
+                "observed": metric["observed"],
+                "configured_limit": metric["configured_limit"],
+                "enforced": True,
+                "source": f"phase-isolated run manifest {path}",
+            },
+            "seed_selection": {
+                **manifest["seed_selection"],
+                "source": f"predeclared seed in run manifest {path}",
+            },
+            "evaluation": {
+                **evaluation,
+                "source": f"final test result recorded by run manifest {path}",
+            },
+        })
+    return {
+        "schema_version": 1,
+        "kind": "gepa_upstream_evidence",
+        "source": {
+            "archive_sha256": sha256_file(archive),
+            "upstream_commit": f"gepa-ai/gepa-artifact@{PINNED_COMMITS['gepa_artifact']} corrected harness",
+            "dspy_commit": PINNED_COMMITS["dspy"],
+            "arbor_commit": PINNED_COMMITS["arbor"],
+        },
+        "runs": sorted(runs, key=lambda run: (run["family"], run["optimizer"])),
+    }
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--run-root", type=Path, required=True)
+    parser.add_argument("--archive", type=Path, required=True)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    paths = sorted(args.run_root.glob("**/evidence_manifest.json"))
+    atomic_json_dump(args.out, build_sidecar(paths, args.archive))
+
+
+if __name__ == "__main__":
+    main()
