+import json
+import os
+import tempfile
+import threading
+import unittest
+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+
+from gepa_artifact.utils.evidence import (
+    MetricBudgetExceeded,
+    PhaseMetricCounter,
+    RunEvidenceRecorder,
+    atomic_json_dump,
+    pinned_provenance,
+)
+from scripts.build_upstream_evidence_sidecar import load_run_manifest
+
+
+ROOT = Path(__file__).resolve().parents[1]
+SENTINEL = "offline-sentinel-secret-7f8c3a"
+
+
+class CorrectedComparatorHarnessTest(unittest.TestCase):
+    def test_gepa_and_mipro_shaped_concurrent_runs_never_execute_over_budget(self):
+        for optimizer in ("GEPA", "MIPROv2-Heavy"):
+            with self.subTest(optimizer=optimizer):
+                counter = PhaseMetricCounter(optimizer_limit=7)
+                executed = 0
+                lock = threading.Lock()
+
+                def callback():
+                    nonlocal executed
+                    counter.reserve("val")
+                    with lock:
+                        executed += 1
+
+                counter.set_phase("optimization")
+                with ThreadPoolExecutor(max_workers=16) as pool:
+                    futures = [pool.submit(callback) for _ in range(40)]
+                errors = [future.exception() for future in futures if future.exception()]
+
+                self.assertEqual(executed, 7)
+                self.assertEqual(counter.snapshot()["phases"]["optimization"], 7)
+                self.assertTrue(all(isinstance(error, MetricBudgetExceeded) for error in errors))
+
+    def test_baseline_final_test_has_an_independent_hard_limit(self):
+        counter = PhaseMetricCounter(phase_limits={"final_test": 3})
+        counter.set_phase("final_test")
+        for _ in range(3):
+            counter.reserve("test")
+        with self.assertRaises(MetricBudgetExceeded):
+            counter.reserve("test")
+        self.assertEqual(counter.snapshot()["phases"]["final_test"], 3)
+
+    def test_manifests_attribute_baseline_and_optimizer_counts_to_distinct_phases(self):
+        cases = (("Baseline", None, "final_test"), ("MIPROv2-Heavy", 2, "optimization"))
+        with tempfile.TemporaryDirectory() as directory:
+            for optimizer, optimizer_limit, expected_phase in cases:
+                run_dir = Path(directory) / optimizer
+                counter = PhaseMetricCounter(
+                    optimizer_limit=optimizer_limit,
+                    phase_limits={"final_test": 1},
+                )
+                if optimizer_limit:
+                    with counter.phase("optimization"):
+                        for _ in range(optimizer_limit):
+                            counter.reserve("val")
+                with counter.phase("final_test"):
+                    counter.reserve("test")
+                result = run_dir / "evaluation_result.txt"
+                result.parent.mkdir(parents=True)
+                result.write_text("score\n1.0\n", encoding="utf-8")
+                recorder = RunEvidenceRecorder(
+                    run_dir,
+                    {"family": "AIMEBench", "program": "CoT", "optimizer": optimizer, "model": "offline", "seed": 0},
+                    counter,
+                    {"repositories": {}},
+                    synthetic=True,
+                )
+                recorder.finalize("completed", score=1.0, result_path=result)
+                metric = json.loads((run_dir / "evidence_manifest.json").read_text())["metric_call_evidence"]
+                self.assertEqual(metric["evidence_phase"], expected_phase)
+                self.assertEqual(metric["observed"], metric["configured_limit"])
+
+    def test_atomic_configs_and_synthetic_manifests_redact_secrets(self):
+        old = os.environ.get("OFFLINE_API_TOKEN")
+        os.environ["OFFLINE_API_TOKEN"] = SENTINEL
+        try:
+            with tempfile.TemporaryDirectory() as directory:
+                root = Path(directory)
+                atomic_json_dump(root / "config.json", {
+                    "api_key": SENTINEL,
+                    "nested": {"password": SENTINEL},
+                    "repr_like": f"Optimizer(api_key={SENTINEL})",
+                })
+                counter = PhaseMetricCounter(optimizer_limit=1, phase_limits={"final_test": 1})
+                with counter.phase("optimization"):
+                    counter.reserve("train")
+                with counter.phase("final_test"):
+                    counter.reserve("test")
+                result = root / "evaluation_result.txt"
+                result.write_text("score\n1.0\n", encoding="utf-8")
+                recorder = RunEvidenceRecorder(
+                    root,
+                    {"family": "AIMEBench", "program": "CoT", "optimizer": "GEPA", "model": "offline", "seed": 0},
+                    counter,
+                    {"credential_for_test": SENTINEL},
+                    synthetic=True,
+                )
+                recorder.finalize("completed", score=1.0, result_path=result)
+
+                for path in root.glob("*.json"):
+                    self.assertNotIn(SENTINEL, path.read_text(encoding="utf-8"))
+                manifest = json.loads((root / "evidence_manifest.json").read_text())
+                self.assertTrue(manifest["synthetic"])
+                with self.assertRaisesRegex(ValueError, "synthetic"):
+                    load_run_manifest(root / "evidence_manifest.json")
+                self.assertFalse(list(root.glob(".*.json.*")))
+        finally:
+            if old is None:
+                os.environ.pop("OFFLINE_API_TOKEN", None)
+            else:
+                os.environ["OFFLINE_API_TOKEN"] = old
+
+    def test_checkout_provenance_verifies_all_exact_pins(self):
+        provenance = pinned_provenance(ROOT)
+        commits = {
+            name: data["commit"]
+            for name, data in provenance["repositories"].items()
+        }
+        self.assertEqual(commits, {
+            "gepa_artifact": "cbefbc1aa0f43dd39874ec4bf42211365dbda42e",
+            "dspy": "62dc3b634d7dc0c4889abcf905cb4c391ea6b396",
+            "arbor": "113fc35e05acbf2796a5917ec3b45ab44bfacd0b",
+        })
+
+    def test_runner_wires_backstops_for_mipro_and_all_gepa_variants(self):
+        configs = (ROOT / "scripts/experiment_configs.py").read_text(encoding="utf-8")
+        runner = (ROOT / "scripts/run_experiments.py").read_text(encoding="utf-8")
+        self.assertEqual(configs.count("add_metric_budget_backstop=True"), 4)
+        mipro_block = configs.split('"MIPROv2-Heavy"', 1)[1].split('"GEPA-MERGE"', 1)[0]
+        self.assertIn("add_metric_budget_backstop=True", mipro_block)
+        self.assertIn('with metric_counter.phase("optimization")', runner)
+        self.assertIn('with metric_counter.phase("final_test")', runner)
+
+
+if __name__ == "__main__":
+    unittest.main()
