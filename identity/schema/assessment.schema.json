{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/dsex/identity/assessment.schema.json",
  "title": "Identity candidate assessment event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "candidate_id",
    "assessed_at",
    "assessor",
    "context",
    "scores",
    "confidence",
    "reasoning"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^assessment-[a-z0-9][a-z0-9-]*$"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^cand-[a-f0-9]{16}$"
    },
    "assessed_at": {
      "type": "string",
      "format": "date-time"
    },
    "assessor": {
      "type": "object",
      "required": ["kind", "name"],
      "properties": {
        "kind": {
          "enum": ["human", "agent", "model", "research", "test"]
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "audience_id": {
          "type": ["string", "null"]
        },
        "architecture_id": {
          "type": ["string", "null"]
        },
        "scenario_id": {
          "type": ["string", "null"]
        }
      }
    },
    "scores": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 5
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reasoning": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "supersedes": {
      "type": ["string", "null"]
    }
  }
}
