{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/dsex/identity/portfolio.schema.json",
  "title": "Identity generation portfolio",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run", "candidates"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "generated_at",
        "generator",
        "method",
        "brief",
        "atlas_version",
        "intended_territories",
        "intended_strategies",
        "intended_audiences"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^run-[a-z0-9][a-z0-9-]*$"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "generator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": {
              "enum": ["human", "agent", "model", "algorithm", "corpus"]
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "provider": {
              "type": ["string", "null"]
            },
            "model": {
              "type": ["string", "null"]
            },
            "reasoning_effort": {
              "type": ["string", "null"]
            },
            "agent_id": {
              "type": ["string", "null"]
            }
          }
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "brief": {
          "type": "string",
          "minLength": 1
        },
        "prompt_path": {
          "type": ["string", "null"]
        },
        "prompt_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "atlas_version": {
          "type": "integer",
          "minimum": 1
        },
        "parent_run_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^run-[a-z0-9][a-z0-9-]*$"
          },
          "uniqueItems": true,
          "default": []
        },
        "intended_territories": {
          "$ref": "#/$defs/idArray"
        },
        "intended_strategies": {
          "$ref": "#/$defs/idArray"
        },
        "intended_audiences": {
          "$ref": "#/$defs/idArray"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ordinal",
          "surface",
          "rationale",
          "territories",
          "strategies"
        ],
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 1
          },
          "surface": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "pronunciation": {
            "type": ["string", "null"]
          },
          "grammar": {
            "type": ["string", "null"]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "etymology": {
            "type": ["string", "null"]
          },
          "territories": {
            "$ref": "#/$defs/idArray"
          },
          "strategies": {
            "$ref": "#/$defs/idArray"
          },
          "audience_lenses": {
            "$ref": "#/$defs/idArray"
          },
          "architecture_lenses": {
            "$ref": "#/$defs/idArray"
          },
          "parent_surfaces": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "known_concerns": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "wildcard": {
            "type": "boolean",
            "default": false
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          }
        }
      }
    }
  },
  "$defs": {
    "idArray": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "uniqueItems": true
    }
  }
}
