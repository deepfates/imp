{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/dsex/identity/flag.schema.json",
  "title": "Identity candidate factual or interpretive flag",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "candidate_id",
    "flagged_at",
    "assessor",
    "kind",
    "severity",
    "status",
    "scope",
    "summary",
    "confidence",
    "evidence_refs"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^flag-[a-z0-9][a-z0-9-]*$"},
    "candidate_id": {"type": "string", "pattern": "^cand-[a-f0-9]{16}$"},
    "flagged_at": {"type": "string", "format": "date-time"},
    "assessor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {
        "kind": {"enum": ["human", "agent", "model", "research", "test"]},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "kind": {
      "enum": [
        "package-collision",
        "repository-collision",
        "product-collision",
        "company-collision",
        "mark-concern",
        "search-confusion",
        "pronunciation",
        "spelling",
        "linguistic",
        "cultural",
        "accessibility",
        "technical-claim",
        "institutional-claim",
        "code-ergonomics",
        "scope",
        "tone",
        "other"
      ]
    },
    "severity": {"enum": ["info", "low", "medium", "high", "critical"]},
    "status": {"enum": ["observed", "inferred", "unverified", "resolved", "disputed"]},
    "scope": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "supersedes": {"type": ["string", "null"]}
  }
}
