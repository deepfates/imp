{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/dsex/identity/enrichment.schema.json",
  "title": "Identity candidate enrichment event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "candidate_id",
    "enriched_at",
    "assessor",
    "spoken_forms",
    "code_forms",
    "prose_forms",
    "architecture_forms",
    "international_notes",
    "international_screen",
    "future_scope_notes"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^enrichment-[a-z0-9][a-z0-9-]*$"},
    "candidate_id": {"type": "string", "pattern": "^cand-[a-f0-9]{16}$"},
    "enriched_at": {"type": "string", "format": "date-time"},
    "assessor": {"$ref": "#/$defs/assessor"},
    "spoken_forms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pronunciation", "recommendation", "support_call"],
      "properties": {
        "pronunciation": {"type": ["string", "null"]},
        "recommendation": {"type": "string"},
        "support_call": {"type": "string"},
        "ambiguities": {"type": "array", "items": {"type": "string"}, "default": []}
      }
    },
    "code_forms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hex_package", "otp_app", "module_root", "mix_task_prefix", "config_prefix", "telemetry_prefix"],
      "properties": {
        "hex_package": {"type": ["string", "null"]},
        "otp_app": {"type": ["string", "null"]},
        "module_root": {"type": ["string", "null"]},
        "mix_task_prefix": {"type": ["string", "null"]},
        "config_prefix": {"type": ["string", "null"]},
        "telemetry_prefix": {"type": ["string", "null"]},
        "code_concerns": {"type": "array", "items": {"type": "string"}, "default": []}
      }
    },
    "prose_forms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readme_headline", "paper_title", "conference_sentence", "error_sentence"],
      "properties": {
        "readme_headline": {"type": "string"},
        "paper_title": {"type": "string"},
        "conference_sentence": {"type": "string"},
        "error_sentence": {"type": "string"}
      }
    },
    "architecture_forms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["architecture_id", "form", "notes"],
        "properties": {
          "architecture_id": {"type": "string"},
          "form": {"type": "string"},
          "notes": {"type": "string"}
        }
      }
    },
    "international_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["language_or_region", "observation", "confidence", "evidence_refs"],
        "properties": {
          "language_or_region": {"type": "string"},
          "observation": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "international_screen": {"$ref": "#/$defs/international_screen"},
    "future_scope_notes": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "default": []},
    "supersedes": {"type": ["string", "null"]}
  },
  "$defs": {
    "assessor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {
        "kind": {"enum": ["human", "agent", "model", "algorithm", "research", "test"]},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "international_screen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "method",
        "basis",
        "input_sha256",
        "evidence_refs",
        "checks",
        "limitations"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "method": {"const": "beam-deterministic-v1"},
        "basis": {"const": "algorithmic-screen"},
        "input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "evidence_refs": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "checks": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/international_check"},
          "allOf": [
            {"contains": {"type": "object", "properties": {"id": {"const": "unicode"}}, "required": ["id"]}},
            {"contains": {"type": "object", "properties": {"id": {"const": "script"}}, "required": ["id"]}},
            {"contains": {"type": "object", "properties": {"id": {"const": "transliteration"}}, "required": ["id"]}},
            {"contains": {"type": "object", "properties": {"id": {"const": "speech-accessibility"}}, "required": ["id"]}},
            {"contains": {"type": "object", "properties": {"id": {"const": "cultural-provenance"}}, "required": ["id"]}}
          ]
        },
        "limitations": {
          "type": "array",
          "minItems": 3,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "international_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "signals"],
      "properties": {
        "id": {
          "enum": [
            "unicode",
            "script",
            "transliteration",
            "speech-accessibility",
            "cultural-provenance"
          ]
        },
        "status": {
          "enum": ["no-machine-signal", "attention", "unverified", "not-applicable"]
        },
        "signals": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    }
  }
}
