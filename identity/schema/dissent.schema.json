{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/dsex/identity/dissent.schema.json",
  "title": "Identity candidate dissent or resurrection event",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "candidate_id", "recorded_at", "author", "position", "context", "reasoning"],
  "properties": {
    "id": {"type": "string", "pattern": "^dissent-[a-z0-9][a-z0-9-]*$"},
    "candidate_id": {"type": "string", "pattern": "^cand-[a-f0-9]{16}$"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {
        "kind": {"enum": ["human", "agent", "model", "research"]},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "position": {"enum": ["support", "oppose", "wildcard", "resurrect", "reinterpret"]},
    "context": {"type": "string", "minLength": 1},
    "reasoning": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "default": []},
    "supersedes": {"type": ["string", "null"]}
  }
}
