# DSPy Elixir 04: Production And Live Provider

```elixir
repo = if File.exists?("mix.exs"), do: File.cwd!(), else: Path.expand("..", __DIR__)
Mix.install([{:dspy_elixir, path: repo}])
```

## Deterministic Gates

Run these in a terminal from the repo root:

```sh
mix production.check
mix v2.check
```

These gates are the project contract. They check formatting, compilation,
parity classifications, audit rows, and deterministic tests.

## Security Posture

Unknown external keys remain strings:

```elixir
key = "external_key_#{System.unique_integer([:positive])}"
example = DSPy.Example.new(%{key => "value"})

{
  DSPy.Example.get(example, key),
  try do
    String.to_existing_atom(key)
  rescue
    ArgumentError -> :not_interned
  end
}
```

Trace redaction:

```elixir
echo = DSPy.Tool.new(:echo, "echo", fn input -> input end)

agent =
  DSPy.Agent.new(:redactor, fn agent, _input, runtime ->
    DSPy.Agent.call_tool(agent, :echo, %{api_key: "sk-live", nested: %{token: "secret"}}, runtime)
  end, tools: [echo])

{:ok, _output, runtime} = DSPy.Agent.run(agent, %{})
runtime.traces
```

## Optional Live Provider

This cell expects `OPENAI_API_KEY` to be present in your environment. Do not
paste secrets into the notebook.

```elixir
if System.get_env("OPENAI_API_KEY") do
  model = System.get_env("OPENAI_MODEL") || "gpt-4o-mini"
  lm = DSPy.openai(model, opts: [temperature: 0, max_completion_tokens: 40])
  program = DSPy.predict("question -> answer", lm: lm)
  DSPy.Predict.Predict.call(program, %{question: "Reply with exactly: pong"})
else
  {:skip, "Set OPENAI_API_KEY before running the live provider cell."}
end
```

## Live Gate

In a terminal:

```sh
set -a
. ./.env
set +a
LIVE_PROVIDER=1 mix test --include live test/live_provider_test.exs
```

## Saving Without Secrets

```elixir
lm = DSPy.openai("gpt-test", api_key: "not-persisted")
program = DSPy.predict("question -> answer", lm: lm)

path = Path.join(System.tmp_dir!(), "dspy-elixir-no-secret.json")
DSPy.Saving.save!(program, path)
state = File.read!(path)
loaded = DSPy.Saving.load!(path)
File.rm(path)

{
  String.contains?(state, "not-persisted"),
  loaded.lm.api_key
}
```
