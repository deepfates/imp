# DSEx 04: Production And Live Provider

```elixir
repo = if File.exists?("mix.exs"), do: File.cwd!(), else: Path.expand("..", __DIR__)
Mix.install([{:dsex, path: repo}])
```

## Deterministic Gates

Run these in a terminal from the repo root:

```sh
mix production.check
mix integration.check
```

These gates are the local project contract. They check formatting, compilation,
public-surface tests, deterministic gates, and local service integration.

## Security Posture

Unknown external keys remain strings:

```elixir
key = "external_key_#{System.unique_integer([:positive])}"
example = DSEx.Example.new(%{key => "value"})

{
  DSEx.Example.get(example, key),
  try do
    String.to_existing_atom(key)
  rescue
    ArgumentError -> :not_interned
  end
}
```

Trace redaction:

```elixir
echo = DSEx.Tool.new(:echo, "echo", fn input -> input end)

agent =
  DSEx.Agent.new(:redactor, fn agent, _input, runtime ->
    DSEx.Agent.call_tool(agent, :echo, %{api_key: "sk-live", nested: %{token: "secret"}}, runtime)
  end, tools: [echo])

{:ok, _output, runtime} = DSEx.Agent.run(agent, %{})
runtime.traces
```

## Optional Live Provider

This cell expects `OPENAI_API_KEY` to be present in your environment. Do not
paste secrets into the notebook.

```elixir
if System.get_env("OPENAI_API_KEY") do
  model = System.get_env("OPENAI_MODEL") || "gpt-4o-mini"
  lm = DSEx.openai(model, opts: [temperature: 0, max_completion_tokens: 40])
  program = DSEx.predict("question -> answer", lm: lm)
  DSEx.call(program, %{question: "Reply with exactly: pong"})
else
  {:skip, "Set OPENAI_API_KEY before running the live provider cell."}
end
```

## Live Gate

In a terminal:

```sh
set -a
. ./.env
set +a
LIVE_PROVIDER=1 mix live.check
```

## Saving Without Secrets

```elixir
lm = DSEx.openai("gpt-test", api_key: "not-persisted")
program = DSEx.predict("question -> answer", lm: lm)

path = Path.join(System.tmp_dir!(), "dsex-no-secret.json")
DSEx.Saving.save!(program, path)
state = File.read!(path)
loaded = DSEx.Saving.load!(path)
File.rm(path)

{
  String.contains?(state, "not-persisted"),
  loaded.lm.api_key
}
```
